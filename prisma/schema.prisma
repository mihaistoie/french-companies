generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum EstablishmentType {
  PRIMARY
  SECONDARY
  UNKNOWN
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id                       String @id @default(uuid()) @db.Uuid
  name                     String   @db.VarChar(255)
  legalForm                String?  @db.VarChar(100)
  establishmentType        EstablishmentType @default(UNKNOWN)
  holdingCompanyId         String? @db.Uuid
  siret                    String  @unique @db.VarChar(14)
  siren                    String  @db.VarChar(9)
  codeNaf                  String? @db.VarChar(6)
  legalUnitWorkforceRange  String? @db.VarChar(2)
  establishmentWorkforceRange String? @db.VarChar(2)
  vatNumber                String?  @unique @db.VarChar(32)
  industry                 String? @db.VarChar(150)
  website                  String? @db.VarChar(2048)
  email                    String? @db.VarChar(255)
  phone                    String? @db.VarChar(32)
  description              String?
  addressLine1             String? @db.VarChar(255)
  addressLine2             String? @db.VarChar(255)
  address                  String? @db.VarChar(600)
  postalCode               String? @db.VarChar(20)
  city                     String? @db.VarChar(120)
  region                   String? @db.VarChar(120)
  country                  String   @default("France") @db.VarChar(120)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  nafCode                  CodeNaf? @relation(fields: [codeNaf], references: [code], onDelete: SetNull)
  holdingCompany           Company? @relation("CompanyHoldings", fields: [holdingCompanyId], references: [id], onDelete: SetNull)
  subsidiaries             Company[] @relation("CompanyHoldings")

  @@index([name])
  @@index([city])
  @@index([postalCode])
  @@index([industry])
  @@index([siren])
  @@index([codeNaf])
  @@index([address])
  @@index([holdingCompanyId])
}

model CodeNaf {
  code      String    @id @db.VarChar(6)
  title     String    @db.VarChar(255)
  altCode   String    @unique @db.VarChar(6)
  companies Company[]

  @@index([altCode])
}
